# Docker Compose 环境变量示例
# 复制为 .env 后修改

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=serverprobe
JWT_SECRET=change-this-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Agent 注册密钥当前通过配置文件传递：
#   server/config.yaml -> agent.register_secret
#   agent/config.docker.yaml -> server.register_secret
# 请保持两处一致。
AGENT_REGISTER_SECRET=change-me-in-production

# 可选：覆盖 Demo Agent 上报的主机名（默认使用宿主机 hostname）
AGENT_HOSTNAME=
