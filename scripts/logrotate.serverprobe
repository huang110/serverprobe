/opt/serverprobe/server/logs/*.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0640 serverprobe serverprobe
    sharedscripts
    postrotate
        systemctl reload serverprobe-server > /dev/null 2>&1 || true
    endscript
}

/var/log/serverprobe/*.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
    sharedscripts
    postrotate
        systemctl reload serverprobe-agent > /dev/null 2>&1 || true
    endscript
}
